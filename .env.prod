APP_NAME="FreeClock Manager"
APP_ENV=production
APP_KEY=
# Change this if you need debug msgs
APP_DEBUG=false

# REQUIRED: set url here
APP_URL=http://localhost
# REQUIRED: set same url here
ASSET_URL=http://localhost
# REQUIRED: set docker port here:
APP_PORT=80

# serversideup docker custom UID/GID: change this if needed
UID=1000
GID=1000

# REQUIRED: italian language by default: change to en if you want
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
APP_TIMEZONE=Europe/Rome

# WARNING: After changing the admin credentials, set the email domain here for security
ADMIN_EMAIL_DOMAIN=

# Set to 1 to seed the database on first boot (quotes, riddles, categories, admin user)
FIRST_SEED=1

# Project URL shown on the dashboard (default: https://github.com/Matese-Makers/FreeClock)
# PROJECT_URL=https://github.com/Matese-Makers/FreeClock

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
#DB_CONNECTION=mysql
#DB_HOST=mysql
#DB_PORT=3306
#DB_DATABASE=laravel
#DB_USERNAME=sail
#DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
#QUEUE_CONNECTION=database
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST="MAIL HOST HERE"
MAIL_PORT=465
MAIL_USERNAME="MAIL USERNAME HERE"
MAIL_PASSWORD="PASSWORD_HERE"
MAIL_FROM_ADDRESS="MAIL FROM HERE"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
